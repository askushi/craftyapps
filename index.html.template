    <script>
        const cards = [...document.querySelectorAll(".app-card")];
        const filters = [...document.querySelectorAll(".filter")];
        const search = document.querySelector("#app-search");
        const resultsNote = document.querySelector("#results-note");
        const themeToggle = document.querySelector("#theme-toggle");
        let selectedCategory = "all";

        themeToggle.addEventListener("click", () => {
            const nextTheme = document.documentElement.dataset.theme === "light"
                ? "dark"
                : "light";
            document.documentElement.dataset.theme = nextTheme;
            const nextLabel = `Switch to ${nextTheme === "light" ? "dark" : "light"} mode`;
            themeToggle.setAttribute("aria-label", nextLabel);
            themeToggle.setAttribute("title", nextLabel);
        });

        function updateCards() {
            const query = search.value.trim().toLocaleLowerCase();
            let matchCount = 0;

            for (const card of cards) {
                const categoryMatches = selectedCategory === "all" ||
                    card.dataset.category === selectedCategory;
                const searchMatches = !query ||
                    `${card.dataset.app} ${card.querySelector(".app-name").textContent} ${card.dataset.category}`
                        .toLocaleLowerCase()
                        .includes(query);

                card.classList.toggle("is-category-dimmed", !categoryMatches);
                card.classList.toggle("is-search-dimmed", Boolean(query) && !searchMatches);
                card.classList.toggle("is-search-match", Boolean(query) && searchMatches);

                if (categoryMatches && searchMatches) {
                    matchCount += 1;
                }
            }

            if (query) {
                resultsNote.textContent = `${matchCount} matching ${matchCount === 1 ? "app" : "apps"}`;
            } else if (selectedCategory === "all") {
                resultsNote.textContent = `Showing all ${cards.length} apps`;
            } else {
                const categoryName = filters.find(
                    (filter) => filter.dataset.filter === selectedCategory
                ).textContent;
                resultsNote.textContent = `${matchCount} ${categoryName.toLowerCase()} ${matchCount === 1 ? "app" : "apps"}`;
            }
        }

        for (const filter of filters) {
            filter.addEventListener("click", () => {
                selectedCategory = filter.dataset.filter;
                for (const button of filters) {
                    button.setAttribute("aria-pressed", String(button === filter));
                }
                updateCards();
            });
        }

        search.addEventListener("input", updateCards);
    </script>
