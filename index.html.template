<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#090d1c">
    <title>ArtCraft Apps</title>
    <style>
        :root {
            color-scheme: dark;
            --page: #090d1c;
            --surface: #121a2d;
            --surface-hover: #19243a;
            --text: #f3f5ff;
            --muted: #9aa8c2;
            --line: #293650;
            --cyan: #62ddff;
            --violet: #bb83ff;
            --control: rgba(18, 26, 45, .92);
            --control-text: #acb7cb;
            --button-text: #dce5f7;
        }

        :root[data-theme="light"] {
            color-scheme: light;
            --page: #f3f6fc;
            --surface: #ffffff;
            --surface-hover: #f7faff;
            --text: #172033;
            --muted: #5f6e85;
            --line: #d6deeb;
            --cyan: #087da5;
            --violet: #7850b5;
            --control: rgba(255, 255, 255, .96);
            --control-text: #53627a;
            --button-text: #24334d;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-width: 320px;
            margin: 0;
            background:
                radial-gradient(ellipse at 50% -18%, rgba(80, 103, 206, .16), transparent 38rem),
                var(--page);
            color: var(--text);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            line-height: 1.5;
        }

        a {
            color: inherit;
        }

        .shell {
            width: min(1120px, calc(100% - 40px));
            margin-inline: auto;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 22px 0;
            border-bottom: 1px solid rgba(164, 185, 225, .12);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 750;
            letter-spacing: .02em;
            text-decoration: none;
        }

        .brand-mark {
            display: grid;
            width: 32px;
            height: 32px;
            place-items: center;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--cyan), var(--violet));
            color: #10152a;
            font-weight: 900;
        }

        .top-link {
            color: var(--muted);
            font-size: .88rem;
            text-decoration: none;
        }

        .top-link:hover {
            color: var(--text);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .theme-toggle {
            display: grid;
            width: 38px;
            height: 38px;
            place-items: center;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--surface);
            color: var(--text);
            cursor: pointer;
        }

        .theme-toggle:hover {
            border-color: var(--cyan);
        }

        .theme-toggle svg {
            width: 18px;
            height: 18px;
        }

        .theme-toggle .sun-icon,
        :root[data-theme="light"] .theme-toggle .moon-icon {
            display: none;
        }

        :root[data-theme="light"] .theme-toggle .sun-icon {
            display: block;
        }

        main {
            padding: 40px 0 64px;
        }

        .page-title {
            margin: 0;
            background: linear-gradient(100deg, #72e5ff 10%, #a9a0ff 52%, #e090ff 90%);
            background-clip: text;
            color: transparent;
            font-size: clamp(2.5rem, 7vw, 4.2rem);
            font-weight: 800;
            letter-spacing: -.06em;
            line-height: 1.08;
            text-align: center;
            -webkit-background-clip: text;
        }

        .intro {
            max-width: 640px;
            margin: 13px auto 28px;
            color: var(--muted);
            text-align: center;
        }

        .search-wrap {
            position: relative;
            width: min(100%, 560px);
            margin: 0 auto 17px;
        }

        .search-icon {
            position: absolute;
            top: 50%;
            left: 15px;
            width: 17px;
            height: 17px;
            color: #8795af;
            pointer-events: none;
            transform: translateY(-50%);
        }

        .search {
            width: 100%;
            min-height: 46px;
            padding: 0 16px 0 43px;
            border: 1px solid #2a3550;
            border-radius: 12px;
            outline: none;
            background: var(--control);
            color: var(--text);
            font: inherit;
            font-size: .9rem;
        }

        .search::placeholder {
            color: #74819a;
        }

        .search:focus {
            border-color: #5daee0;
            box-shadow: 0 0 0 3px rgba(98, 221, 255, .12);
        }

        .filters {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin: 0 0 17px;
        }

        .filter {
            min-height: 31px;
            padding: 4px 13px;
            border: 1px solid #303a54;
            border-radius: 999px;
            background: var(--control);
            color: var(--control-text);
            cursor: pointer;
            font: inherit;
            font-size: .78rem;
            transition: border-color .18s ease, color .18s ease, background .18s ease;
        }

        .filter:hover {
            border-color: #667b9e;
            color: var(--text);
        }

        .filter[aria-pressed="true"] {
            border-color: var(--cyan);
            background: rgba(98, 221, 255, .1);
            box-shadow: 0 0 14px rgba(98, 221, 255, .12);
            color: #8ae8ff;
        }

        :root[data-theme="light"] .filter[aria-pressed="true"] {
            background: rgba(8, 125, 165, .1);
            color: #075b74;
        }

        .results-note {
            min-height: 1.4em;
            margin: 0 0 13px;
            color: #7f8da7;
            font-size: .78rem;
            text-align: center;
        }

        .app-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 176px), 1fr));
            gap: 13px;
        }

        .app-card {
            display: flex;
            min-width: 0;
            min-height: 246px;
            flex-direction: column;
            align-items: center;
            padding: 17px 14px 14px;
            border: 1px solid var(--line);
            border-radius: 16px;
            background:
                radial-gradient(ellipse at 50% 0%, rgba(112, 145, 210, .12), transparent 72%),
                var(--surface);
            text-align: center;
            transition: opacity .2s ease, filter .2s ease, border-color .2s ease,
                box-shadow .2s ease, transform .2s ease, background-color .2s ease;
        }

        .app-card:hover {
            transform: translateY(-3px);
            border-color: rgba(98, 221, 255, .55);
            background-color: var(--surface-hover);
        }

        .app-card.is-category-dimmed {
            opacity: .24;
            filter: saturate(.45);
        }

        .app-card.is-search-dimmed {
            opacity: .34;
            filter: saturate(.55);
        }

        .app-card.is-search-match {
            border-color: rgba(98, 221, 255, .82);
            box-shadow: 0 0 0 1px rgba(98, 221, 255, .22), 0 0 24px rgba(98, 221, 255, .15);
        }

        .app-card.is-category-dimmed.is-search-match {
            opacity: .24;
        }

        .app-logo-link {
            display: grid;
            width: 102px;
            height: 102px;
            flex: 0 0 102px;
            place-items: center;
            overflow: hidden;
            border: 1px solid rgba(172, 197, 242, .24);
            border-radius: 23px;
            background: linear-gradient(145deg, rgba(255,255,255,.1), rgba(255,255,255,.025));
            box-shadow: 0 12px 30px rgba(0, 0, 0, .22), inset 0 1px 0 rgba(255,255,255,.08);
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .app-logo-link:hover,
        .app-logo-link:focus-visible {
            transform: translateY(-2px) scale(1.035);
            box-shadow: 0 14px 34px rgba(0, 0, 0, .28), 0 0 0 3px rgba(98, 221, 255, .2);
            outline: none;
        }

        .app-icon {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .app-name {
            margin: 12px 0 0;
            font-size: .98rem;
            font-weight: 730;
            letter-spacing: -.015em;
        }

        .app-version {
            margin-top: 1px;
            color: var(--muted);
            font-size: .76rem;
        }

        .app-actions {
            display: flex;
            width: 100%;
            gap: 8px;
            margin-top: auto;
            padding-top: 13px;
        }

        .button {
            display: inline-flex;
            min-width: 0;
            min-height: 34px;
            flex: 1;
            align-items: center;
            justify-content: center;
            padding: 0 8px;
            border: 1px solid #34415e;
            border-radius: 9px;
            background: rgba(255,255,255,.035);
            color: var(--button-text);
            font-size: .76rem;
            font-weight: 700;
            text-decoration: none;
            transition: border-color .18s ease, background .18s ease;
        }

        .button:hover {
            border-color: #6d819f;
            background: rgba(255,255,255,.09);
        }

        .button-get {
            border-color: rgba(98, 221, 255, .38);
            background: rgba(98, 221, 255, .1);
            color: #8ae8ff;
        }

        .button-get:hover {
            border-color: var(--cyan);
            background: rgba(98, 221, 255, .17);
        }

        :root[data-theme="light"] .button-get {
            border-color: #9acbd9;
            background: #e4f5f9;
            color: #075b74;
        }

        :root[data-theme="light"] .button-get:hover {
            border-color: #53a9bf;
            background: #d3eef4;
        }

        .promos {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 60px;
        }

        .promo {
            position: relative;
            min-height: 190px;
            padding: 23px;
            border: 1px solid var(--line);
            border-radius: 17px;
            background: linear-gradient(140deg, rgba(98,221,255,.1), transparent 58%), var(--surface);
        }

        .promo:nth-child(2) {
            background: linear-gradient(140deg, rgba(187,131,255,.13), transparent 58%), var(--surface);
        }

        .promo-label {
            margin: 0 0 8px;
            color: #83e4ff;
            font-size: .7rem;
            font-weight: 750;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        :root[data-theme="light"] .promo-label {
            color: #08718e;
        }

        .promo:nth-child(2) .promo-label {
            color: #c89cff;
        }

        :root[data-theme="light"] .promo:nth-child(2) .promo-label {
            color: #7242a5;
        }

        .promo h2 {
            margin: 0;
            padding-right: 92px;
            font-size: 1.3rem;
        }

        .promo-copy {
            max-width: 580px;
            margin: 9px 0 14px;
            color: var(--muted);
            font-size: .88rem;
        }

        .promo-logo {
            position: absolute;
            top: 21px;
            right: 21px;
            width: 186px;
            max-height: 60px;
            object-fit: contain;
            object-position: right center;
        }

        .promo-logo-rosetta {
            width: 89px;
            max-height: 42px;
        }

        /* :root[data-theme="light"] .promo-logo-rosetta {
            filter: brightness(0);
        } */

        .promo-link {
            color: var(--text);
            font-size: .84rem;
            font-weight: 700;
            text-decoration-color: var(--cyan);
            text-underline-offset: 4px;
        }

        footer {
            padding: 20px 0 28px;
            border-top: 1px solid rgba(164, 185, 225, .12);
            color: #8390a9;
            font-size: .8rem;
        }

        @media (max-width: 620px) {
            .shell {
                width: min(100% - 28px, 1120px);
            }

            main {
                padding-top: 32px;
            }

            .app-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
            }

            .app-card {
                min-height: 230px;
                padding-inline: 10px;
            }

            .app-logo-link {
                width: 88px;
                height: 88px;
                flex-basis: 88px;
                border-radius: 20px;
            }

            .promos {
                grid-template-columns: 1fr;
                margin-top: 44px;
            }
        }

        @media (max-width: 360px) {
            .app-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>
